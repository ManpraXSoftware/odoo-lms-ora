<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="email_template_staff_review_submitted" model="mail.template">
            <field name="name">Staff Review Submitted</field>
            <field name="model_id" ref="website_ora_elearning.model_open_response_rubric_staff"/>
            <field name="subject">Staff Review Submitted for {{ ctx.get('slide_name') }}</field>
            <field name="email_to">{{ ctx.get('staff_email') }}</field>
            <field name="body_html">
                <![CDATA[
                <t t-name="email_template_staff_review_submitted">
                    <p>Hello <t t-esc="ctx.get('staff_name')"/>!</p>
                    <p>User <strong><t t-esc="ctx.get('user_name')"/></strong> has submitted a response for your review.</p>
                    <p>Please assess the submission related to the course slide: <strong><t t-esc="ctx.get('slide_name')"/></strong>.</p>
                    <p>We appreciate your feedback.</p>
                    <p>Thank you!</p>
                </t>
                ]]>
            </field>
        </record>

    </data>
</odoo>
