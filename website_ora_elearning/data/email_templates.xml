<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="email_template_peer_review_submitted" model="mail.template">
            <field name="name">Peer Review Submitted</field>
            <field name="model_id" ref="website_ora_elearning.model_open_response_rubric_staff"/>
            <field name="subject">Peer Review Submitted for {{ ctx.get('slide_name') }}</field>
            <field name="email_from">odoobot@example.com</field>
            <field name="email_to">{{ ctx.get('peer_user_email') }}</field>
            <field name="body_html">
                <![CDATA[
                    <p>Hello <span t-out="ctx.get('peer_user_name')"></span>,</p>
                    <p>User <span t-out="ctx.get('user_name')"></span> has submitted an assessment.</p>
                    <div style="padding: 16px 8px;">
                        <a t-att-href="ctx.get('slide_url')"
                            style="background-color: #875a7b; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                                View ORA Response
                        </a>
                    </div>
                    <p>Kindly review it. The course slide is <strong t-out="ctx.get('slide_name')"></strong>.</p>
                    <p>We appreciate your feedback.</p>
                    <p>Thank you!</p>
                ]]>
            </field>
        </record>

        <record id="email_template_staff_review_submitted" model="mail.template">
            <field name="name">Staff Review Submitted</field>
            <field name="model_id" ref="website_ora_elearning.model_open_response_rubric_staff"/>
            <field name="subject">Staff Review Submitted for {{ ctx.get('slide_name') }}</field>
            <field name="email_from">odoobot@example.com</field>
            <field name="email_to">{{ ctx.get('staff_email') }}</field>
            <field name="body_html">
                <![CDATA[
                <t t-name="email_template_staff_review_submitted">
                    <p>Hello <t t-esc="ctx.get('staff_name')"/>!</p>
                    <p>User <strong><t t-esc="ctx.get('user_name')"/></strong> has submitted a response for your review.</p>
                    <a t-att-href="ctx.get('slide_url')"
                        style="background-color: #875a7b; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                            View ORA Response
                    </a>
                    <p>Please assess the submission related to the course slide: <strong><t t-esc="ctx.get('slide_name')"/></strong>.</p>
                    <p>We appreciate your feedback.</p>
                    <p>Thank you!</p>
                </t>
                ]]>
            </field>
        </record>

        <record id="mail_template_peer_assessment_completed" model="mail.template">
            <field name="name">Peer Assessment Completed</field>
            <field name="model_id" ref="website_ora_elearning.model_ora_response"/>
            <field name="subject">All Peer Assessments Completed</field>
            <field name="email_from">odoobot@example.com</field>
            <field name="email_to">{{ ctx.get('user_email') }}</field>
            <field name="body_html"><![CDATA[
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                    <p>Hello,</p>
                    <p>
                        All peer assessments for the slide titled 
                        <strong><t t-esc="ctx.get('slide_name')"/></strong> have now been completed.
                    </p>
                    <div style="padding: 16px 8px;">
                        <a t-att-href="ctx.get('url')"
                            style="background-color: #875a7b; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                            View ORA Response
                        </a>
                    </div>
                    <p>
                        We kindly invite you to review the learner’s submission at your earliest convenience.
                    </p>
                    <p>Thank you!</p>
                    <p>Best regards,<br/>
                    <t t-esc="ctx.get('peer_name_str')"/></p>
                </div>
            ]]></field>
        </record>

        <record id="email_template_assessment_completed" model="mail.template">
            <field name="name">Assessment Completed</field>
            <field name="model_id" ref="website_ora_elearning.model_ora_response"/>
            <field name="subject">Your Assessment is Completed</field>
            <field name="email_from">odoobot@example.com</field>
            <field name="email_to">{{ ctx.get('user_email') }}</field>
            <field name="body_html"><![CDATA[
                <p>Hello <span t-out="ctx.get('user_name')"></span>,</p>
                <p>Your assessment for the ORA content titled <strong><span t-out="ctx.get('slide_name')"></span></strong> has been reviewed and evaluated by <strong><span t-out="ctx.get('staff_name')"></span></strong>.</p>
                <div style="padding: 16px 8px;">
                    <a t-att-href="ctx.get('url')"
                        style="background-color: #875a7b; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px;">
                        View ORA Response
                    </a>
                </div>
                <p>Kindly check the feedback at your convenience.</p>
                <p>Thank you!</p>
            ]]></field>
        </record>
    </data>
</odoo>
