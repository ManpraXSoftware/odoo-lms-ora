<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mark_assessed_wizard_form" model="ir.ui.view">
        <field name="name">mark.assessed.wizard.form</field>
        <field name="model">mark.assessed.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Assessment">
                <group string="Assessment Details">
                    <field name="response_id" invisible="1" />
                    <field name="user_response_lines" nolabel="1">
                        <kanban>
                            <field name="question_name"/>
                            <field name="value_combined"/>
                            <field name="slide_id"/>
                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_card oe_kanban_global_click">
                                        <div class="oe_kanban_details">
                                            <strong><field name="question_name"/></strong>
                                            <div><field name="value_combined"/></div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </group>

                <group string="Peer Assessments" invisible="not peer_staff_lines">
                    <field name="peer_staff_lines" nolabel="1">
                        <kanban>
                            <field name="user_id"/>
                            <field name="submitted_date"/>
                            <field name="state"/>
                            <field name="total_score"/>
                            <templates>
                                <t t-name="card">
                                    <div class="oe_kanban_card oe_kanban_global_click">
                                        <div class="oe_kanban_details">
                                            <strong><field name="user_id"/></strong>
                                            <div>Submitted: <field name="submitted_date"/></div>
                                            <div>State: <field name="state"/></div>
                                            <div>Score: <field name="total_score"/></div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </group>

                <group string="Create Slide Rubric Staff Line">
                    <div class="oe_title" style="margin-bottom: 16px; padding: 16px; border: 1px solid #ccc; border-radius: 8px; box-shadow: 2px 2px 8px #ddd;">
                        <group>
                            <field name="criteria_id" />
                            <field name="option_id" invisible="criteria_id == False" domain="[('rubric_id', '=', criteria_id)]" required="1"/>
                            <field name="criteria_option_point" readonly="1"/>
                            <field name="assess_explanation" required="1"/>
                        </group>
                    </div>
                </group>

                <footer>
                    <button string="Confirm" type="object" name="confirm_assessment" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>